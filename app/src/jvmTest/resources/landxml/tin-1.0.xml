<?xml version="1.0" encoding="UTF-8"?>
<!--
  TIN версии 1.0 (KoTIN-60): у F нет атрибутов, контрольных чисел в Definition нет, как в 6.xml корпуса.
  Квадрат 20 × 20 (восток 100…120, север 200…220), отметка 10 в углах и 14 в середине (точка 6): четыре грани веером.
-->
<LandXML xmlns="http://www.landxml.org/schema/LandXML-1.0" version="1.0">
  <Units>
    <Imperial linearUnit="foot"/>
  </Units>
  <Surfaces>
    <Surface name="Рельеф 1.0">
      <Definition surfType="TIN">
        <Pnts>
          <P id="2">200 100 10</P>
          <P id="3">200 120 10</P>
          <P id="4">220 120 10</P>
          <P id="5">220 100 10</P>
          <P id="6">210 110 14</P>
        </Pnts>
        <Faces>
          <F>2 3 6</F>
          <F>3 4 6</F>
          <F>4 5 6</F>
          <F>5 2 6</F>
        </Faces>
      </Definition>
    </Surface>
  </Surfaces>
</LandXML>
