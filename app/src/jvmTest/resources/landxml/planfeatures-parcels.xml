<?xml version="1.0" encoding="UTF-8"?>
<!-- Фикстура ситуации и участков (KoTIN-65): координаты «север восток», в сцене x — восток, y — север.
     Наклонная поверхность 200×200 под всем: линии и точки без отметок садятся на неё (KoTIN-67),
     ограждение с отметками идёт над ней. -->
<LandXML xmlns="http://www.landxml.org/schema/LandXML-1.2" date="2026-10-14" time="12:00:00" version="1.2">
	<Units><Metric linearUnit="meter" areaUnit="squareMeter" volumeUnit="cubicMeter" temperatureUnit="celsius" pressureUnit="milliBars"/></Units>
	<Project name="PlanFeatures и Parcels"/>
	<Application name="KoTIN" version="1.0"/>
	<CgPoints>
		<CgPoint name="ОП3">170 60 17</CgPoint>
		<CgPoint name="Ц1б">115 165</CgPoint>
	</CgPoints>
	<PlanFeatures name="Площадка">
		<!-- бровка: прямая, четверть дуги R 20 против часовой (центр (60, 30)), прямая — одна открытая ломаная -->
		<PlanFeature name="Бровка" desc="верх откоса">
			<CoordGeom>
				<Line><Start>10 10</Start><End>10 60</End></Line>
				<Curve rot="ccw" crvType="arc" radius="20"><Start>10 60</Start><Center>30 60</Center><End>30 80</End></Curve>
				<Line><Start>30 80</Start><End>90 80</End></Line>
			</CoordGeom>
		</PlanFeature>
		<!-- контур здания: замкнутая IrregularLine 40×30, площадь 1200 -->
		<PlanFeature name="Здание">
			<CoordGeom>
				<IrregularLine><Start>20 100</Start><End>20 100</End><PntList2D>20 100 20 140 50 140 50 100 20 100</PntList2D></IrregularLine>
			</CoordGeom>
			<FieldNote>обмер 2026</FieldNote>
		</PlanFeature>
		<!-- ограждение с отметками: PntList3D — линия не flat -->
		<PlanFeature name="Ограждение">
			<CoordGeom>
				<IrregularLine><Start>120 10</Start><End>130 100</End><PntList3D>120 10 14 120 60 16 130 100 18</PntList3D></IrregularLine>
			</CoordGeom>
		</PlanFeature>
		<!-- опоры: две точки текстом (с отметкой и без) и одна ссылкой на CgPoint -->
		<PlanFeature name="Опора освещения">
			<Location>150 20</Location>
			<Location>160 40 16.5</Location>
			<Location pntRef="ОП3"/>
		</PlanFeature>
		<!-- без имени — слой «Ситуация» -->
		<PlanFeature>
			<CoordGeom>
				<Line><Start>190 150</Start><End>190 190</End></Line>
			</CoordGeom>
		</PlanFeature>
	</PlanFeatures>
	<Parcels name="Квартал">
		<!-- участок 80×60 (площадь 4800) из трёх сторон — четвёртую дорисовывает читатель; подпись в Center -->
		<Parcel name="Участок 1" area="4800" parcelType="Lot" class="Жилая" desc="угловой">
			<Center>150 130</Center>
			<CoordGeom>
				<Line><Start>100 110</Start><End>100 190</End></Line>
				<Line><Start>100 190</Start><End>160 190</End></Line>
				<Line><Start>160 190</Start><End>160 110</End></Line>
			</CoordGeom>
			<Parcels>
				<!-- вложенный: замкнутый квадрат 20×20, Center нет — подпись в центре габаритов (130, 120) -->
				<Parcel name="Участок 1а" area="400">
					<CoordGeom>
						<IrregularLine><Start>110 120</Start><End>110 120</End><PntList2D>110 120 110 140 130 140 130 120 110 120</PntList2D></IrregularLine>
					</CoordGeom>
				</Parcel>
				<!-- вложенный: прямая и полуокружность R 15 против часовой — замкнут, площадь π·15²/2; Center по ссылке -->
				<Parcel name="Участок 1б">
					<CoordGeom>
						<Line><Start>110 150</Start><End>110 180</End></Line>
						<Curve rot="ccw" crvType="arc" radius="15"><Start>110 180</Start><Center>110 165</Center><End>110 150</End></Curve>
					</CoordGeom>
					<Center pntRef="Ц1б"/>
				</Parcel>
			</Parcels>
		</Parcel>
	</Parcels>
	<Surfaces>
		<Surface name="Рельеф">
			<Definition surfType="TIN">
				<Pnts>
					<P id="1">0 0 10</P>
					<P id="2">0 200 12</P>
					<P id="3">200 200 20</P>
					<P id="4">200 0 15</P>
				</Pnts>
				<Faces>
					<F>1 2 3</F>
					<F>1 3 4</F>
				</Faces>
			</Definition>
		</Surface>
	</Surfaces>
</LandXML>
