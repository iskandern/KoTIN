<?xml version="1.0" encoding="UTF-8"?>
<!--
  Поверхность grid (KoTIN-60): сетка 3 × 3 точки с шагом 10 (восток 0…20, север 0…20), z = восток / 10;
  id = 1 + 3·ряд + столбец (ряд — север). Четыре ячейки по четыре id против часовой стрелки, в двух элементах Faces:
  каждая ячейка — два треугольника по диагонали 1–3, диагональ в каркасе скрыта. Площадь 2D 400, 3D 400·√1,01.
  Вторая поверхность — только SourceData, без Definition: сетки нет, ошибки нет.
-->
<LandXML xmlns="http://www.landxml.org/schema/LandXML-1.2" date="2026-10-13" time="12:00:00" version="1.2">
  <Units>
    <Metric areaUnit="squareMeter" linearUnit="meter" volumeUnit="cubicMeter" temperatureUnit="celsius" pressureUnit="milliBars"/>
  </Units>
  <Surfaces>
    <Surface name="Сетка">
      <Definition surfType="grid" area2DSurf="400" area3DSurf="401.99502484483567" elevMin="0" elevMax="2">
        <Pnts>
          <P id="1">0 0 0</P>
          <P id="2">0 10 1</P>
          <P id="3">0 20 2</P>
          <P id="4">10 0 0</P>
          <P id="5">10 10 1</P>
          <P id="6">10 20 2</P>
          <P id="7">20 0 0</P>
          <P id="8">20 10 1</P>
          <P id="9">20 20 2</P>
        </Pnts>
        <Faces>
          <F>1 2 5 4</F>
          <F>2 3 6 5</F>
        </Faces>
        <Faces>
          <F>4 5 8 7</F>
          <F>5 6 9 8</F>
        </Faces>
      </Definition>
    </Surface>
    <Surface name="Только исходные">
      <SourceData>
        <DataPoints>
          <PntList3D>0 0 0 10 10 1 20 20 2</PntList3D>
        </DataPoints>
      </SourceData>
    </Surface>
  </Surfaces>
</LandXML>
